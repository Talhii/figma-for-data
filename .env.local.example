# ── Supabase (pgvector) ───────────────────────────────────────────────
# Not required while the app runs on the mock RAG layer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI ────────────────────────────────────────────────────────────
# When set, the AI router can be switched from mock mode to live calls.
OPENAI_API_KEY=

# Toggle the AI agent router between "mock" (default) and "live".
AI_ROUTER_MODE=mock
